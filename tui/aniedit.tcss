DownloadScreen {
    align: center middle;
}

#download-section {
    width: 70;
    height: auto;
    border: round $primary;
    padding: 1 2;
}

#download-title {
    text-align: center;
    width: 100%;
    margin-bottom: 1;
    pointer: text;
}

#output-row {
    height: 3;
    width: 100%;
}

#output-path-input {
    width: 1fr;
}

#browse-btn {
    width: 12;
    min-width: 12;
    height: 3;
    margin: 0;
    border: tall transparent;
}

#start-download-btn {
    width: 100%;
    margin-top: 1;
    margin-bottom: 1;
    pointer: pointer;
}

Button:focus {
    text-style: bold;
}

NotificationModal {
    align: center middle;
    background: rgba(0, 0, 0, 0.7);
}

.modal-container {
    width: 50;
    height: auto;
    padding: 2 4;
    border: thick $primary;
    background: $surface;
}

#notification-message {
    width: 100%;
    content-align: center middle;
    margin-bottom: 2;
}

#welcome-instructions {
    width: 100%;
    height: auto;
    margin-bottom: 2;
}

#modal-progress-bar {
    width: 100%;
    margin: 0 0 2 0;
    padding: 0;
}

#close-modal-btn {
    width: 100%;
}

SettingScreen {
    align: center middle;
}

#settings-main {
    width: 70;
    height: auto;
    padding: 2 4;
}

#settings-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 2;
    width: 100%;
    text-align: center;
}

.setting-item {
    width: 100%;
    margin-bottom: 2;
    height: auto;
}

.setting-row {
    width: 100%;
    height: auto;
    margin-top: 1;
}

#default-folder-label {
    width: 1fr;
    content-align: left middle;
    color: $text-muted;
}

#browse-folder-btn {
    min-width: 12;
    height: 3;
}

.switch-row {
    layout: horizontal;
    align: left middle;
}

.switch-row Label {
    width: 1fr;
    content-align: left middle;
}
